{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Library Management System",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": [
        "--app",
        "run.py",
        "run",
        "--debug",
        "--host",
        "127.0.0.1"
      ],
      "jinja": true,
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "Running on (http://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
